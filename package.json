{
  "name": "otxto-cms",
  "version": "1.0.0",
  "description": "Sports news CMS landing page on Cloudflare Workers",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "db:create": "wrangler d1 create otxto-cms",
    "db:migrate": "wrangler d1 execute otxto-cms --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
